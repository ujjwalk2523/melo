# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000

# Audius Provider Configuration (Required for live Audius searches)
AUDIUS_API_URL=https://discoveryprovider.audius.co
AUDIUS_APP_NAME=melo_app

# Jamendo Provider Configuration (Optional - requires Jamendo Client ID)
# Register at https://devportal.jamendo.com/ to obtain a Client ID
JAMENDO_API_URL=https://api.jamendo.com/v3.0
JAMENDO_CLIENT_ID=

# Authentication & JWT Configuration
JWT_SECRET=melo_secret_jwt_key_development_2026

# Supabase / PostgreSQL Configuration (Optional for cloud sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
